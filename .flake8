[flake8]
max-line-length = 88
extend-ignore = E203, E266, E501, W503, F401
exclude =
    .git,
    __pycache__,
    build,
    dist,
    .eggs,
    *.egg-info,
    .venv,
    venv,
    env,
    ENV
per-file-ignores =
    __init__.py:F401
    cvm/__init__.py:F401
    cvm/core/__init__.py:F401
    cvm/games/__init__.py:F401
